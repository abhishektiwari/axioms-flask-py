# Flask Axioms SDK Configuration Example
# Copy this file to .env and update with your values

# ============================================================================
# Required Configuration
# ============================================================================
# Required: Your resource identifier or API audience
AXIOMS_AUDIENCE=your-api-audience-or-resource-identifier

# ============================================================================
# Configuration Hierarchy (Choose One)
# ============================================================================
# The SDK uses the following construction order:
# 1. AXIOMS_ISS_URL → constructs → AXIOMS_JWKS_URL (if not explicitly set)
# 2. AXIOMS_DOMAIN → constructs → AXIOMS_ISS_URL → AXIOMS_JWKS_URL (if not explicitly set)
#
# You must provide at least one of: AXIOMS_ISS_URL, AXIOMS_DOMAIN, or AXIOMS_JWKS_URL

# Option 1: Issuer URL configuration (recommended)
# Provide the full issuer URL from your authorization server
# The SDK will construct JWKS URL as: {AXIOMS_ISS_URL}/.well-known/jwks.json
AXIOMS_ISS_URL=https://auth.example.com

# Option 2: Simple domain configuration
# Use this for simple cases where issuer is just https://{domain}
# This automatically constructs:
# - Issuer URL: https://{AXIOMS_DOMAIN}
# - JWKS URL: https://{AXIOMS_DOMAIN}/.well-known/jwks.json
# AXIOMS_DOMAIN=your-domain.axioms.io

# Option 3: Explicit JWKS URL (overrides automatic construction)
# Use this when your JWKS endpoint doesn't follow the standard .well-known pattern
# AXIOMS_JWKS_URL=https://auth.example.com/custom-path/jwks.json

# ============================================================================
# Optional Configuration
# ============================================================================

# Safe HTTP Methods (Optional)
# List of HTTP methods that bypass authorization checks (useful for CORS preflight)
# Default: ["OPTIONS"]
# AXIOMS_SAFE_METHODS=["OPTIONS","HEAD"]

# Allowed Token Types (Optional)
# List of allowed token types in JWT 'typ' header
# Default: ["JWT","jwt","at+jwt","application/jwt"]
# AXIOMS_TOKEN_TYPS=["JWT"]

# JWKS Refresh Settings (Optional)
# JWKS refresh interval in seconds
# Default: 3600 (1 hour)
# AXIOMS_JWKS_REFRESH_INTERVAL=3600

# JWKS cache TTL in seconds (must be >= 2x AXIOMS_JWKS_REFRESH_INTERVAL)
# Default: 7200 (2 hours)
# AXIOMS_JWKS_CACHE_TTL=7200

# Whether to prefetch JWKS on initialization
# Default: True
# AXIOMS_JWKS_PREFETCH=True

# ============================================================================
# Claim Name Mapping (Optional)
# ============================================================================
# Configure custom claim names to support different authorization servers.
# The SDK checks claims in priority order, using the first non-None value found.
# Defaults: scope=["scope"], roles=["roles"], permissions=["permissions"]

# Custom Scope Claim Names (Optional)
# Some servers use 'scp' instead of 'scope'
# AXIOMS_SCOPE_CLAIMS=["scope","scp"]

# Custom Roles Claim Names (Optional)
# AXIOMS_ROLES_CLAIMS=["roles"]

# Custom Permissions Claim Names (Optional)
# AXIOMS_PERMISSIONS_CLAIMS=["permissions"]

# ============================================================================
# Authorization Server Specific Examples
# ============================================================================

# Example: AWS Cognito Configuration
# Cognito uses 'cognito:groups' for groups/roles
# AXIOMS_ROLES_CLAIMS=["cognito:groups","roles"]
# AXIOMS_PERMISSIONS_CLAIMS=["cognito:roles","permissions"]

# Example: Auth0 with Custom Namespace
# Auth0 uses standard 'permissions' but may also use custom namespaced claims
# AXIOMS_PERMISSIONS_CLAIMS=["permissions","http://my-app.com/claims/permissions"]

# Example: Okta Configuration
# Okta typically uses 'groups' claim
# AXIOMS_ROLES_CLAIMS=["groups","roles"]

# Example: Namespaced Claims
# You can directly specify namespaced claim names in your configuration
# AXIOMS_ROLES_CLAIMS=["roles","https://myapp.com/claims/roles"]
# AXIOMS_PERMISSIONS_CLAIMS=["permissions","http://myapp.com/claims/permissions"]
